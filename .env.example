# ───────────────────────────── Contrail configuration ─────────────────────────────
# Copy to .env. Everything is optional: with no keys at all the app runs on the built-in
# synthetic traffic feed so you can explore every feature offline.

# Which live feeds to poll (comma-separated): synthetic | adsblol | airplaneslive | opensky
# adsb.lol and airplanes.live need no key. OpenSky is slow/credit-limited without an account.
FEEDS=synthetic
# Restrict polling and storage to a region: west,south,east,north (strongly recommended for OpenSky)
#FEED_BBOX=-12,35,30,62
# Demo feed size (10000+ to stress-test rendering)
SYNTHETIC_COUNT=1500

# ── Position feeds ──
# OpenSky Network (https://opensky-network.org/) — OAuth2 client credentials from your account page
#OPENSKY_CLIENT_ID=
#OPENSKY_CLIENT_SECRET=
# legacy basic auth alternative
#OPENSKY_USERNAME=
#OPENSKY_PASSWORD=
OPENSKY_INTERVAL_MS=15000
# readsb-style APIs (adsb.lol / airplanes.live): ≤1 request/second, keep the default
ADSBLOL_INTERVAL_MS=6000
AIRPLANESLIVE_INTERVAL_MS=6000
# Regions polled when a feed has no global endpoint: "lat,lon,radiusNm;lat,lon,radiusNm" (max 250 nm each)
#READSB_REGIONS=51.5,-0.5,250;40.6,-74,250

# ── Schedules & routes (optional; without them origin/destination comes from adsb.lol's free route database) ──
# AeroDataBox via RapidAPI (https://rapidapi.com/aedbx-aedbx/api/aerodatabox)
#AERODATABOX_API_KEY=
# AviationStack (https://aviationstack.com/) — free tier is HTTP only
#AVIATIONSTACK_API_KEY=
#AVIATIONSTACK_BASE_URL=http://api.aviationstack.com/v1

# ── Photos, weather, data layers ──
PLANESPOTTERS_ENABLED=true          # https://www.planespotters.net/photo/api (attribution shown in the UI)
#AIRWAYS_GEOJSON_URL=               # optional GeoJSON LineStrings for the airways layer (e.g. exported from openAIP)
#FIR_GEOJSON_URL=                   # override bundled FIR boundaries
OURAIRPORTS_REFRESH=false           # true = download fresh OurAirports CSVs at startup
#AIRLINE_LOGO_URL_TEMPLATE=https://example-cdn/logos/{iata}.png   # otherwise badges are generated

# ── Storage & recording ──
POSITION_RETENTION_DAYS=7
RECORD_POSITIONS=true
RECORD_MIN_INTERVAL_S=5
# docker-compose builds DATABASE_URL from these:
POSTGRES_USER=contrail
POSTGRES_PASSWORD=contrail
POSTGRES_DB=contrail
# for local dev outside docker:
#DATABASE_URL=postgres://contrail:contrail@localhost:5432/contrail

# ── Accounts, alerts, notifications ──
JWT_SECRET=change-me-to-a-long-random-string
# Web push: run `npx web-push generate-vapid-keys`
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Email alerts (any nodemailer SMTP URL)
#SMTP_URL=smtps://user:pass@smtp.example.com:465
SMTP_FROM=Contrail <no-reply@example.com>

# ── Web / deployment ──
WEB_PORT=3000
PUBLIC_URL=http://localhost:3000
#CORS_ORIGINS=https://contrail.example.com
# Build-time keys for the web app (optional)
#VITE_MAPTILER_KEY=                 # vector basemaps (https://cloud.maptiler.com/)
#VITE_CESIUM_ION_TOKEN=             # 3D terrain & OSM buildings (https://ion.cesium.com/)
